# =============================================
# The Shield Protocol - Backend Configuration
# =============================================

# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=8h

# Admin Credentials (change before deploying)
ADMIN_EMAIL=admin@shieldprotocol.com
ADMIN_PASSWORD=ShieldAdmin@2026

# =============================================
# EMAIL PROVIDER CONFIGURATION
# Choose one provider and fill in its section
# =============================================

# Active email provider: smtp | gmail | sendgrid | brevo | resend
EMAIL_PROVIDER=gmail

# --- SMTP (Generic) ---
SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@email.com
SMTP_PASS=yourpassword

# --- Gmail SMTP ---
GMAIL_USER=your.gmail@gmail.com
GMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx

# --- SendGrid ---
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM=noreply@yourdomain.com

# --- Brevo (Sendinblue) ---
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your@email.com
BREVO_SMTP_PASS=your_brevo_smtp_key

# --- Resend ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=noreply@yourdomain.com

# Sender Identity
EMAIL_FROM_NAME=The Shield Protocol Team
EMAIL_FROM_ADDRESS=noreply@shieldprotocol.com

# File Storage
UPLOAD_DIR=uploads
QR_OUTPUT_DIR=generated-qr

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# =============================================
# SUPABASE CONFIGURATION (Database & Storage)
# =============================================
USE_SUPABASE=false
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

